<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <!-- Definições do seu projeto -->
    <groupId>com.github.alessondornelles</groupId>
    <artifactId>AcmeHr</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Define a versão do Java (ajuste para a versão que você usa, ex: 17, 21, etc.) -->
            <maven.compiler.source>27</maven.compiler.source>
            <maven.compiler.target>27</maven.compiler.target>
            <maven.compiler.release>27</maven.compiler.release>
            <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Dependência do JUnit 5 (Jupiter) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin necessário para o Maven conseguir rodar os testes do JUnit 5 via linha de comando -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>
